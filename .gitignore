## -----------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Production build outputs
dist/
dist-ssr/
build/

# Vite cache
.vite/
*.tmp
*.bak

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

