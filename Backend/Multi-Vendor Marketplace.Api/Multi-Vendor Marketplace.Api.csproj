    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Multi-Vendor E-commerce Marketplace.Infrastructures\Multi-Vendor Marketplace.Infrastructures.csproj" />
